    "ai.coach.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me about training, recovery, nutrition or running form. I keep context for the current session."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивай про тренировки, восстановление, питание и технику бега. Контекст сессии я помню."
          }
        }
      }
    },
