    "ИИ КАРДИО-ТРЕНЕР": {},
    "ИИ КРОСС-АНАЛИЗ": {},
    "ИИ НЕЙРО-СВОДКА": {},
    "ИИ РЕЦЕПТ ВОССТАНОВЛЕНИЯ": {},
    "ИИ ТЕРМИНАЛ": {},
    "ИИ проанализировал твои параметры. Тебе больше не нужно думать о норме шагов. Алгоритм сам подстроит цели под твой темп, погоду и рельеф.\n\nДелай шаги. Мы оцифруем результат.": {},
